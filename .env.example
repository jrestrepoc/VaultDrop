# Copiar a .env y llenar los valores vacios. No subir .env al repositorio.
# Compose no arranca hasta que los secretos tengan valor.
# Generar cada secreto con: openssl rand -hex 32
DJANGO_SECRET_KEY=
# En EC2, agregar la IP elastica: localhost,127.0.0.1,<IP-ELASTICA>
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=vaultdrop
POSTGRES_USER=vaultdrop
POSTGRES_PASSWORD=
HTTP_PORT=80
